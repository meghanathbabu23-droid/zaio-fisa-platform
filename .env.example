DATABASE_URL="file:./dev.db"

# "live" sends real email/SMS via Resend/Twilio. "mock" (dev/test only) never
# calls either provider and never includes the code in any API response —
# tests and scripts/demo-smoke.mjs read it back via the gated /api/test
# endpoint instead, which only exists when this is "mock". Refuses to boot if
# this is "mock" and NODE_ENV=production.
OTP_DELIVERY_MODE=mock

# HMAC pepper for hashing OTP codes before they're stored. Required; must be
# a long random value in production (generate with e.g. `openssl rand -hex 32`).
OTP_HASH_SECRET=

# Default region for phone numbers typed without a leading "+" (admin student
# form and OTP login). South Africa by default per FISA's primary cohort.
DEFAULT_PHONE_REGION=ZA

# Resend (email OTP delivery) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=Zaio FISA

# Twilio (SMS OTP delivery, plain Messages API — not Twilio Verify) — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set explicitly in any real deployment — several safety checks key off this.
NODE_ENV=development

# Comma-separated browser origins allowed to call the API cross-origin.
# Defaults to the local Vite dev server (http://localhost:5173) when unset
# outside production. Required and must be non-empty in production — set it
# to your real admin-dashboard origin(s) once deployed. Must include
# ADMIN_WEB_ORIGIN below (and the student-facing site's origin) or the
# browser will block the admin/student dashboards from calling this API.
ALLOWED_ORIGINS=

# --- Administrator accounts (individual logins, replacing the old shared
# ADMIN_API_KEY) ---------------------------------------------------------
# The admin dashboard's own origin, used to build the link inside
# password-reset emails (e.g. https://admin.yourdomain.com). Defaults to
# http://localhost:5173 if unset. Should also appear in ALLOWED_ORIGINS.
ADMIN_WEB_ORIGIN=

# Optional: raises the per-IP rate limit on POST /api/admin/login above its
# production default of 10 requests / 15 minutes. Leave unset in any real
# deployment — this exists only so automated tests (which drive many admin
# logins from one IP) don't trip the production limiter.
# ADMIN_LOGIN_IP_LIMIT_MAX=

# There is no default/bootstrap administrator account and no password baked
# into this codebase. Create the first SUPER_ADMIN once, from the server
# directory, with:
#   npm run bootstrap-admin -- --email you@yourdomain.com --name "Your Name"
# You'll be prompted for the password interactively (hidden) — never a CLI
# argument. This refuses to run again once any administrator exists.

# --- Temporary open tester self-registration (see docs/OPEN-TEST-REGISTRATION.md) ---
# Lets anyone hit POST /api/auth/register-tester with a name/email/mobile and
# get a real (test-marked) student record, for internal testing without an
# admin creating each account by hand. DANGEROUS if ever reachable in
# production — three conditions must ALL hold or it's completely disabled
# (returns 404, same as if the route didn't exist):
#   1. NODE_ENV is not "production"
#   2. OTP_DELIVERY_MODE=mock
#   3. this flag is exactly "true"
# The server refuses to even start if this is "true" while NODE_ENV=production.
# Leave unset (disabled) unless you are actively doing internal test-account
# registration right now.
# ENABLE_OPEN_TEST_REGISTRATION=true
