{
  "name": "zaio-fisa-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "heroku-postbuild": "prisma generate --schema=prisma-production/schema.production.prisma && npm run build",
    "render-build": "prisma generate --schema=prisma/schema.mongodb.prisma && npm run build",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:generate:mongo": "prisma generate --schema=prisma/schema.mongodb.prisma",
    "db:push": "prisma db push",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:fisa": "tsx scripts/seed-fisa-assessment.ts",
    "deactivate-legacy-exams": "tsx scripts/deactivate-legacy-exams.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:live-delivery": "tsx scripts/test-live-delivery.ts",
    "test": "vitest run",
    "test:mongo": "vitest run --config vitest.mongo.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^6.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "jsdom": "^31.0.0",
    "libphonenumber-js": "^1.13.16",
    "nodemailer": "^10.5.0",
    "prisma": "^6.1.0",
    "resend": "^6.37.0",
    "twilio": "^6.3.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
